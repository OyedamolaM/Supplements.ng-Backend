NODE_ENV=development
PORT=5000

# PostgreSQL runtime connection for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplements_ng

CLIENT_URL=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:3000

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PAYSTACK_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REFUND_APPROVAL_THRESHOLD=0
INVENTORY_APPROVAL_THRESHOLD=0

# Bootstrap seed values for a fresh Postgres setup
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@supplements.ng
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me
BOOTSTRAP_SUPER_ADMIN_PHONE=
BOOTSTRAP_DEFAULT_TAX_RATE=7.5
