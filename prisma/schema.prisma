generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  ACCOUNTANT
  INVENTORY_MANAGER
  CASHIER
  STAFF
}

enum TaxCategory {
  STANDARD
  EXEMPT
  ZERO
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum UsageMode {
  FIXED
  AS_NEEDED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
}

enum ApprovalType {
  INVENTORY_ADJUSTMENT
  REFUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PrescriptionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FULFILLED
}

model Branch {
  id                 String              @id
  name               String
  address            String
  phone              String
  region             String              @default("")
  isOnline           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  orders             Order[]             @relation("OrderBranch")
  originOrders       Order[]             @relation("OrderOriginBranch")
  branchInventories  BranchInventory[]
  inventoryMovements InventoryMovement[]
  activityLogs       ActivityLog[]
  approvalRequests   ApprovalRequest[]
  suppliers          Supplier[]
  supplierInvoices   SupplierInvoice[]
}

model User {
  id                        String              @id
  name                      String
  phone                     String              @default("")
  email                     String              @unique
  password                  String
  emailVerified             Boolean             @default(true)
  emailVerifiedAt           DateTime?
  emailVerificationCode     String              @default("")
  emailVerificationExpiresAt DateTime?
  passwordResetCode         String              @default("")
  passwordResetExpiresAt    DateTime?
  appleSubject              String?             @unique
  avatarUrl                 String              @default("")
  passwordChangedAt         DateTime            @default(now())
  dateOfBirth               DateTime?
  gender                    String              @default("")
  bloodGroup                String              @default("")
  genotype                  String              @default("")
  allergies                 String              @default("")
  medications               String              @default("")
  conditions                String              @default("")
  assignedPharmacistName    String              @default("")
  role                      UserRole            @default(CUSTOMER)
  branchId                  String?
  branch                    Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  region                    String              @default("")
  deactivatedAt             DateTime?
  accountDeletionRequestedAt DateTime?
  accountDeletionScheduledFor DateTime?
  accountPurgedAt           DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  shippingAddresses         ShippingAddress[]
  prescriptions             Prescription[]
  reminders                 CustomerReminder[]
  wishlistItems             UserWishlistItem[]
  cartItems                 UserCartItem[]
  orders                    Order[]             @relation("OrderUser")
  ordersCreated             Order[]             @relation("OrderCreatedBy")
  ordersReturnRequested     Order[]             @relation("OrderReturnRequestedBy")
  ordersReturnApproved      Order[]             @relation("OrderReturnApprovedBy")
  activityLogs              ActivityLog[]       @relation("ActivityUser")
  notificationReads         NotificationRead[]
  approvalRequests          ApprovalRequest[]   @relation("ApprovalRequestedBy")
  approvalsGranted          ApprovalRequest[]   @relation("ApprovalApprovedBy")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")
  suppliersCreated          Supplier[]          @relation("SupplierCreatedBy")
  supplierInvoicesCreated   SupplierInvoice[]   @relation("SupplierInvoiceCreatedBy")

  @@index([accountPurgedAt, accountDeletionScheduledFor])
}

model ShippingAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  addressLine1 String
  addressLine2 String   @default("")
  city         String
  state        String
  country      String
  postalCode   String
  phone        String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, sortOrder])
}

model TaxRate {
  id            String    @id
  name          String
  rate          Float
  effectiveFrom DateTime
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Category {
  id        String   @id
  name      String
  key       String   @unique
  imageUrl  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Product {
  id                   String                @id
  title                String
  description          String                @default("")
  isActiveOnline       Boolean               @default(true)
  deletedAt            DateTime?
  price                Float
  costPrice            Float                 @default(0)
  sellingPrice         Float                 @default(0)
  expiryDate           DateTime?
  stock                Int                   @default(0)
  quantityAvailable    Int                   @default(0)
  sku                  String                @default("")
  batchNumber          String                @default("")
  barcode              String                @default("")
  supplierName         String                @default("")
  reorderLevel         Int                   @default(0)
  taxCategory          TaxCategory           @default(STANDARD)
  taxRateId            String?
  taxRate              TaxRate?              @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  dosageForm           String                @default("")
  strength             String                @default("")
  packSize             String                @default("")
  unitType             String                @default("")
  packQuantity         Float                 @default(0)
  refillable           Boolean               @default(true)
  reorderable          Boolean               @default(true)
  recommendedDosageAmount     Float          @default(0)
  recommendedDosageUnit       String         @default("")
  recommendedFrequencyPerDay  Float          @default(0)
  recommendedUsageText        String         @default("")
  usageMode            UsageMode             @default(FIXED)
  allowManualUsageOverride Boolean           @default(true)
  manufacturer         String                @default("")
  images               String[]
  category             String                @default("General")
  categories           String[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  wishlistItems        UserWishlistItem[]
  cartItems            UserCartItem[]
  reminders            CustomerReminder[]
  orderItems           OrderItem[]
  branchInventories    BranchInventory[]
  inventoryMovements   InventoryMovement[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@index([title])
  @@index([category])
  @@index([deletedAt])
}

model UserWishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model UserCartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  price     Float
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id                        String   @id
  email                     String   @unique
  isActive                  Boolean  @default(true)
  firstOrderDiscountPercent Float    @default(5)
  firstOrderDiscountUsedAt  DateTime?
  firstOrderDiscountUsedOrderId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([isActive, email])
}

model Order {
  id                   String        @id
  userId               String
  branchId             String?
  originBranchId       String?
  paymentMethod        String        @default("Cash on Delivery")
  paymentStatus        PaymentStatus @default(PENDING)
  orderStatus          OrderStatus   @default(PROCESSING)
  subtotal             Float         @default(0)
  taxAmount            Float         @default(0)
  discountAmount       Float         @default(0)
  totalPrice           Float
  createdById          String?
  returnReason         String        @default("")
  returnRequestedById  String?
  returnApprovedById   String?
  customerRating       Int?
  customerRatingNote   String?       @default("")
  customerRatedAt      DateTime?
  shippingFullName     String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingCountry      String?
  shippingPostalCode   String?
  shippingPhone        String?
  deliveryProvider     String?
  deliveryOrderNo      String?
  deliveryStatus       String?
  deliveryTrackingUrl  String?
  deliveryMeta         Json?
  user                 User          @relation("OrderUser", fields: [userId], references: [id], onDelete: Restrict)
  branch               Branch?       @relation("OrderBranch", fields: [branchId], references: [id], onDelete: SetNull)
  originBranch         Branch?       @relation("OrderOriginBranch", fields: [originBranchId], references: [id], onDelete: SetNull)
  createdBy            User?         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  returnRequestedBy    User?         @relation("OrderReturnRequestedBy", fields: [returnRequestedById], references: [id], onDelete: SetNull)
  returnApprovedBy     User?         @relation("OrderReturnApprovedBy", fields: [returnApprovedById], references: [id], onDelete: SetNull)
  prescriptions        Prescription[]
  reminders            CustomerReminder[]
  items                OrderItem[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([branchId, createdAt])
}

model Prescription {
  id              String             @id
  userId          String
  orderId         String?
  title           String
  notes           String             @default("")
  attachmentUrl   String             @default("")
  attachmentName  String             @default("")
  status          PrescriptionStatus @default(PENDING)
  pharmacistNotes String             @default("")
  validUntil      DateTime?
  dosageText      String             @default("")
  pharmacistName  String             @default("")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([orderId])
}

model CustomerReminder {
  id           String   @id
  userId       String
  orderId      String?
  productId    String
  label        String
  intervalDays Int      @default(30)
  nextDueDate  DateTime
  lastOrderedAt DateTime?
  note         String   @default("")
  isPaused     Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, nextDueDate])
  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  title     String
  quantity  Int     @default(1)
  price     Float
  purchaseDate DateTime @default(now())
  packQuantitySnapshot Float @default(0)
  unitTypeSnapshot String @default("")
  recommendedDosageAmountSnapshot Float @default(0)
  recommendedDosageUnitSnapshot String @default("")
  recommendedFrequencyPerDaySnapshot Float @default(0)
  recommendedUsageTextSnapshot String @default("")
  usageModeSnapshot UsageMode @default(FIXED)
  refillableSnapshot Boolean @default(true)
  reorderableSnapshot Boolean @default(true)
  manualOverrideEnabled Boolean @default(false)
  manualDosageAmount Float?
  manualFrequencyPerDay Float?
  manualDaysSupply Int?
  manualUsageText String?
  isPaused Boolean @default(false)
  pausedAt DateTime?
  pausedDays Int @default(0)
  dosageRecommendedByName String?
  dosageRecommendedByRole String?
  dosageRecommendedAt DateTime?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model BranchInventory {
  id        String   @id
  branchId  String
  productId String
  quantity  Int      @default(0)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
}

model InventoryMovement {
  id             String                @id
  branchId       String
  productId      String
  type           InventoryMovementType
  quantityChange Int
  reason         String                @default("")
  referenceType  String                @default("")
  referenceId    String?
  createdById    String?
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
}

model ActivityLog {
  id         String   @id
  userId     String
  action     String
  entityType String   @default("")
  entityId   String?
  branchId   String?
  message    String   @default("")
  meta       Json?
  user       User     @relation("ActivityUser", fields: [userId], references: [id], onDelete: Restrict)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reads      NotificationRead[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([action])
}

model NotificationRead {
  id            String      @id
  userId        String
  activityLogId String?
  computedKey   String?
  readAt        DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLog   ActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@unique([userId, activityLogId])
  @@unique([userId, computedKey])
  @@index([userId, readAt])
}

model ApprovalRequest {
  id            String         @id
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  branchId      String?
  requestedById String
  approvedById  String?
  reason        String         @default("")
  payload       Json?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?          @relation("ApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, type, createdAt])
}

model Supplier {
  id            String            @id
  name          String
  contactName   String            @default("")
  phone         String            @default("")
  email         String            @default("")
  address       String            @default("")
  paymentTerms  String            @default("")
  bankName      String            @default("")
  accountName   String            @default("")
  accountNumber String            @default("")
  notes         String            @default("")
  balance       Float             @default(0)
  branchId      String?
  createdById   String?
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoices      SupplierInvoice[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([name])
}

model SupplierInvoice {
  id            String                      @id
  supplierId    String
  branchId      String
  invoiceNumber String                      @default("")
  reference     String                      @default("")
  dateSupplied  DateTime
  dueDate       DateTime?
  subtotal      Float
  tax           Float                       @default(0)
  total         Float
  amountPaid    Float                       @default(0)
  balance       Float                       @default(0)
  status        SupplierInvoiceStatus       @default(UNPAID)
  notes         String                      @default("")
  createdById   String?
  supplier      Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch        Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy     User?                       @relation("SupplierInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         SupplierInvoiceItem[]
  payments      SupplierInvoicePayment[]
  attachments   SupplierInvoiceAttachment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([supplierId, dateSupplied])
  @@index([branchId, dateSupplied])
}

model SupplierInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  productId   String
  description String          @default("")
  quantity    Int
  unitCost    Float
  total       Float
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model SupplierInvoicePayment {
  id        String          @id @default(cuid())
  invoiceId String
  amount    Float
  method    String          @default("")
  reference String          @default("")
  note      String          @default("")
  date      DateTime        @default(now())
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, date])
}

model SupplierInvoiceAttachment {
  id        String          @id @default(cuid())
  invoiceId String
  url       String
  publicId  String          @default("")
  fileName  String          @default("")
  mimeType  String          @default("")
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
